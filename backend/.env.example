# ---------------------------------------------------------------------------
# AI Visibility Platform — backend configuration
# Copy to backend/.env and fill in your own credentials. Never commit .env.
# ---------------------------------------------------------------------------

# --- Live data provider (required) — https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# DATAFORSEO_BASE_URL=https://api.dataforseo.com
# live (default) | sandbox — sandbox serves SYNTHETIC data in DataForSEO shapes, labelled everywhere; opt-in only
DATAFORSEO_MODE=live

# --- LLM (required: one of the two keys). LLM_PROVIDER is auto-detected from the key you set.
# anthropic | openai
# LLM_PROVIDER=openai
OPENAI_API_KEY=
# Low-cost, non-reasoning, supports function calling + structured outputs (verified available on the key)
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# --- LLM spend governance (enforced server-side BEFORE any request; applies to the active provider)
# 1 planner call + 1 synthesis call
OPENAI_MAX_CALLS_PER_RUN=2
# persistent, atomic counter in SQLite (survives restarts); 0 = never call the LLM
OPENAI_MAX_CALLS_TOTAL=4
# API-side output cap (max_completion_tokens / max_tokens)
OPENAI_MAX_OUTPUT_TOKENS=400
# prompts estimated above ~1.25x this are refused, not sent
OPENAI_MAX_INPUT_TOKENS=2000
# false: never retry a chargeable call (when true, only HTTP 429 is retried)
OPENAI_AUTO_RETRY=false
# identical successful LLM requests are answered from cache (no call, no quota)
LLM_CACHE_TTL_SECONDS=2592000
# extra LLM turns are off by default: invalid tool calls fall back to deterministic plans
LLM_REPAIR_ATTEMPTS=0
# true lets the LLM choose discovery seeds (needs OPENAI_MAX_CALLS_PER_RUN >= 3)
LLM_PLAN_DISCOVERY=false

# --- AI-answer measurement (ChatGPT via DataForSEO LLM Responses)
AI_ANSWER_MODEL=gpt-4o-mini
# web search gives citations; costs more per call (~$0.03)
AI_ANSWER_WEB_SEARCH=true
AI_ANSWER_MAX_OUTPUT_TOKENS=700

# --- Cost protection (per run). Local safeguards, NOT a view of your provider balance.
MAX_RESEARCH_QUERIES_PER_RUN=2
MAX_KEYWORD_DISCOVERY_CALLS_PER_RUN=1
MAX_KEYWORD_METRICS_CALLS_PER_RUN=1
MAX_SERP_CALLS_PER_RUN=2
MAX_AI_VISIBILITY_CALLS_PER_RUN=2
MAX_RUN_COST_USD=0.25
# Labs bills per returned item
KEYWORD_IDEAS_LIMIT=20
# 10 or 20 (20 costs double)
SERP_DEPTH=10
# identical completed requests are reused for free within this window
PROVIDER_CACHE_TTL_SECONDS=21600

# --- Timeouts and retries
DATAFORSEO_TIMEOUT_SECONDS=60
DATAFORSEO_AI_TIMEOUT_SECONDS=130
LLM_TIMEOUT_SECONDS=120
# total attempts, including the first
RETRY_MAX_ATTEMPTS=3
# exponential backoff base (full jitter)
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=20
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_SECONDS=60

# --- Execution and runtime
MAX_CONCURRENT_RUNS=2
MAX_QUEUED_RUNS=4
LOG_LEVEL=INFO
# Docker sets sqlite:////data/ai_visibility.db (volume)
# DATABASE_URL=sqlite:///./data/ai_visibility.db
